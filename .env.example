# ---- 服务 ----
PORT=8080
HOST=0.0.0.0
DEPLOYMENT_ID=local
LOG_LEVEL=info

# New API 上游地址。代理会把除 /admin、/healthz 以外的请求转发到这里。
UPSTREAM_URL=http://127.0.0.1:3000
# 可选：限制上游响应空闲时间（毫秒），0 表示不限制。
UPSTREAM_IDLE_TIMEOUT_MS=0

# ---- 存储 ----
# PostgreSQL（生产推荐）：DATABASE_URL=postgres://user:pass@127.0.0.1:5432/zhlx
# SQLite（本地试用）：DATABASE_URL=file:./data/zhlx.db
DATABASE_URL=file:./data/zhlx.db

# ---- 管理员 ----
# 未设置时管理接口返回 503，代理仍可运行。
ADMIN_API_TOKEN=change-me-admin-token
# 会话 Cookie 签名密钥；不设置时从 ADMIN_API_TOKEN 派生，生产环境建议显式设置。
SESSION_SECRET=
SESSION_TTL_HOURS=8
# HTTPS 部署时设为 true，为会话 Cookie 增加 Secure 标记。
SESSION_COOKIE_SECURE=false
# 仅当本服务前面有可信反向代理时才设为 true，用于登录限流取真实客户端 IP。
TRUST_PROXY_HEADERS=false

# ---- Prompt 采集 ----
# 默认关闭。开启前请确认用途、告知与保留期。
CAPTURE_ENABLED=false
CAPTURE_ROUTES=/v1/chat/completions,/v1/responses,/v1/messages,/v1/completions
CAPTURE_MAX_BYTES=4194304
# 所有在途请求的正文缓冲总预算，超出后新请求只记元数据，避免内存被打满。
CAPTURE_MAX_TOTAL_BYTES=268435456
CAPTURE_MAX_CHARS=8000
PROMPT_RETENTION_DAYS=30
CLEANUP_INTERVAL_MS=3600000

# ---- 有界队列 ----
QUEUE_MAX_METADATA=5000
QUEUE_MAX_CONTENT=500
QUEUE_FLUSH_MS=1000
QUEUE_BATCH_SIZE=200

# ---- 原生日志同步 ----
NEWAPI_LOG_SYNC_ENABLED=false
# 方式一：HTTP 管理员日志接口（NEWAPI_ADMIN_TOKEN 需可访问 /api/log/）
NEWAPI_BASE_URL=http://127.0.0.1:3000
# 管理员 AccessToken；请使用只读权限最小的账户。
NEWAPI_ADMIN_TOKEN=
# 某些 New API 版本需要额外的管理员用户 ID 头。
NEWAPI_ADMIN_USER_ID=
# 方式二：同机部署时直接只读 New API 的 SQLite 日志库。设置后优先于 HTTP 方式。
# 容器部署需把 New API 的 data 目录挂载进来。
# NEWAPI_SQLITE_PATH=/data/one-api.db
NEWAPI_LOG_PAGE_SIZE=100
NEWAPI_LOG_SYNC_INTERVAL_MS=300000
NEWAPI_LOG_INITIAL_BACKFILL_HOURS=24
NEWAPI_LOG_OVERLAP_MS=600000
NEWAPI_LOG_SAFETY_LAG_MS=30000
NEWAPI_LOG_TIMEOUT_MS=30000
# composite（默认，稳定复合键）或 id（仅当确认该部署的日志 id 稳定时）
NEWAPI_SOURCE_KEY_MODE=composite

# 关联状态：收到请求后多久内仍未匹配日志视为 pending
ASSOCIATION_PENDING_WINDOW_MS=300000

# 人员归属口径：auto（默认，仅一个账号但有多个凭证时按凭证）、user（一人一账号）、token（共享账号按 Key 区分）
IDENTITY_MODE=auto

# ---- 二期：离线场景分类 ----
# off（默认，不分类）/ keyword（关键词规则，零成本）/ llm（调用模型，需配置下列凭据）
CLASSIFIER_MODE=off
CLASSIFIER_INTERVAL_MS=300000
CLASSIFIER_BATCH_SIZE=50
CLASSIFIER_MAX_ATTEMPTS=5
CLASSIFIER_RETRY_MS=600000
# 置信度低于该值时标记待复核
CLASSIFIER_REVIEW_THRESHOLD=60
# LLM 模式：OpenAI 兼容接口；未设置 BASE_URL 时复用 UPSTREAM_URL
CLASSIFIER_LLM_BASE_URL=
CLASSIFIER_LLM_TOKEN=
CLASSIFIER_LLM_MODEL=
CLASSIFIER_LLM_TIMEOUT_MS=30000

# 分类服务专用凭证 ID（逗号分隔），按人员/凭证分组时排除，避免污染员工统计
EXCLUDE_TOKEN_IDS=
